# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# New Chintamani Printing Press — Vercel Production & Local Development
# ============================================================================
# Copy this file to .env.local for local overrides or configure in Vercel Project Settings.
# NEVER commit real credentials or .env.local to GitHub.

# ----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Persistence Configuration
# Obtain from your Supabase Dashboard > Project Settings > API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=chintamani_uploads

# ----------------------------------------------------------------------------
# 2. Administrative Authentication & Security
# ----------------------------------------------------------------------------
# Secret key used for signing administrative JWT session tokens (32+ bytes random string)
ADMIN_SESSION_SECRET=your-secure-random-session-secret-here-at-least-32-chars

# Environment mode ('development' or 'production')
NODE_ENV=production
